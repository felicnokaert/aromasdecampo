{
  "rewrites": [
    { "source": "/cal/:para/:archivo", "destination": "/api/ical?para=:para&archivo=:archivo" },
    { "source": "/panel", "destination": "/admin.html" },
    { "source": "/reservar", "destination": "/reservas.html" },
    { "source": "/colon", "destination": "/guia.html" },
    { "source": "/llegada", "destination": "/llegada.html" }
  ],
  "headers": [
    { "source": "/admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/panel", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
